# Copy to backend/.env and fill in. backend/.env is gitignored. Never commit it.

# From https://developer-dashboard.whoop.com → your app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must exactly match a redirect URL registered on your WHOOP app
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/live_training.db

# Where uploaded session files are stored
DATA_DIR=./data
