# Secrets — never commit
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.cer
*.mobileprovision
*.keystore
*.jks
key.properties

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Backend runtime data (SQLite DB, uploaded sessions)
backend/data/
*.db
*.sqlite3

# Analysis outputs (generated; a sample lives in docs/sample/)
analysis/output/

# Flutter / Dart (mobile/.gitignore covers the rest)
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# Xcode per-user data
xcuserdata/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Raw SensorLog exports contain GPS coordinates: never commit them
SensorLogFiles_*
*Apple Watch.csv
